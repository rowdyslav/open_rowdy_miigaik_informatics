# Артефакты сборки CMake — пересоздаются локально, на GitHub не нужны
build/

# Объектные файлы и служебные библиотеки компоновки
*.obj
*.o
*.dll.a

# Настройки IDE и редакторов
.vscode/
.idea/
*.user

# Служебный мусор Windows
Thumbs.db
desktop.ini

